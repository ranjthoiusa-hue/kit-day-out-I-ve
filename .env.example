# Keep real secrets in your local .env file. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Keep false until you have tested OAuth and reviewed uploads.
AUTO_PUBLISH=false

# Set true only when the video is genuinely directed to children.
YOUTUBE_MADE_FOR_KIDS=true

YOUTUBE_CATEGORY_ID=22
YOUTUBE_PRIVACY_STATUS=private
